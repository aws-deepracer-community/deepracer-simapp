#!/bin/bash
INSTALL_PREFIX=$1
mkdir -p $INSTALL_PREFIX/lib
mkdir -p $INSTALL_PREFIX/include

# Copy header files
cp -r --update=none $INSTALL_PREFIX/src/src/source/*.h $INSTALL_PREFIX/include/
cp -r --update=none $INSTALL_PREFIX/src/src/include/* $INSTALL_PREFIX/include/

# Copy open-source headers
cp -r --update=none $INSTALL_PREFIX/src/open-source/include/* $INSTALL_PREFIX/include/

# Create webrtc directory structure if it doesn't exist
mkdir -p $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/webrtcclient

# Create symbolic links for the webrtc include paths
if [ -d "$INSTALL_PREFIX/include/com/amazonaws/kinesis/video/webrtcclient" ]; then
  echo "Creating symbolic links for webrtc include paths"
  # Link the Include.h file
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/webrtcclient/Include.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/webrtcclient/Include.h
  # Link the NullableDefs.h file
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/webrtcclient/NullableDefs.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/webrtcclient/NullableDefs.h
  # Link the Stats.h file
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/webrtcclient/Stats.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/webrtcclient/Stats.h
  
  # Create other necessary webrtc directories and links
  mkdir -p $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/client
  mkdir -p $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/common
  
  # Link client include
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/client/Include.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/client/Include.h
  
  # Link common include
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/common/Include.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/common/Include.h
  cp -f $INSTALL_PREFIX/include/com/amazonaws/kinesis/video/common/jsmn.h $INSTALL_PREFIX/include/webrtc/com/amazonaws/kinesis/video/common/jsmn.h
fi

# Copy the shared libraries with every version name (libfoo.so, libfoo.so.N, libfoo.so.N.M...),
# keeping symlinks as symlinks. Copying only *.so, *.so.1 and *.so.15 missed libwebsockets.so.19
# (the SONAME the SDK libraries load), which then resolved only through the build tree.
for lib in $INSTALL_PREFIX/src/open-source/lib/*.so*; do
    if [ -e "$lib" ]; then cp -P "$lib" $INSTALL_PREFIX/lib/; fi
done
if ls $INSTALL_PREFIX/src/open-source/lib/*.a 1> /dev/null 2>&1; then
    cp $INSTALL_PREFIX/src/open-source/lib/*.a $INSTALL_PREFIX/lib
fi

if ls $INSTALL_PREFIX/build/*.so 1> /dev/null 2>&1; then
    cp $INSTALL_PREFIX/build/*.so $INSTALL_PREFIX/lib
fi
echo "[CMake Build] install-webrtc script executed"