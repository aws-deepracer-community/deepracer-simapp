#!/bin/sh
# Adjust the downloaded KVS WebRTC SDK (v1.12.0) for Ubuntu 26.04. Called from the
# WEBRTC_SDK_IMPORT PATCH_COMMAND with the SDK source directory as $1.
#
# 1. Build against the system OpenSSL (3.5 on Ubuntu 26.04) instead of the OpenSSL 1.1.1t the SDK
#    builds from source when BUILD_DEPENDENCIES is on. OpenSSL 1.1.1 is end of life, and its
#    libraries were never installed next to the SDK, so the installed SDK libraries could not be
#    loaded (libcrypto.so.1.1 not found). webrtc-patches/webrtc-sdk-c.patch was meant to remove
#    this build step but does not apply to v1.12.0 (see the PATCH_COMMAND).
# 2. Do not configure the libwebsockets minimal examples: they include() a file generated by
#    export(), which CMake 4 rejects, and they are not used.
set -e
src="$1"
sed -i \
  -e 's/^\([[:space:]]*\)build_dependency(openssl /\1# system OpenSSL is used instead: build_dependency(openssl /' \
  -e 's/^\([[:space:]]*\)set(OPENSSL_ROOT_DIR \${OPEN_SRC_INSTALL_PREFIX})/\1# set(OPENSSL_ROOT_DIR ${OPEN_SRC_INSTALL_PREFIX})/' \
  -e 's/-DOPENSSL_DIR=\${OPEN_SRC_INSTALL_PREFIX}/-DOPENSSL_DIR=\/usr/' \
  "$src/CMakeLists.txt"
grep -q '# system OpenSSL is used instead: build_dependency(openssl' "$src/CMakeLists.txt"
# The dependencies (libsrtp, libwebsockets) are pointed at the system OpenSSL under /usr.
! grep -q 'OPENSSL_DIR=${OPEN_SRC_INSTALL_PREFIX}' "$src/CMakeLists.txt"
sed -i 's/-DLWS_WITH_MINIMAL_EXAMPLES=1/-DLWS_WITH_MINIMAL_EXAMPLES=0/' \
  "$src/CMake/Dependencies/libwebsockets-CMakeLists.txt"
grep -q -- '-DLWS_WITH_MINIMAL_EXAMPLES=0' "$src/CMake/Dependencies/libwebsockets-CMakeLists.txt"
echo "[prepare-webrtc-sdk] system OpenSSL, no libwebsockets minimal examples"
