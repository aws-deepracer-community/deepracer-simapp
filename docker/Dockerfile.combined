ARG BUNDLE_PREFIX=awsdeepracercommunity
ARG BUNDLE_TAG=latest
ARG CORE_IMG=ubuntu:26.04

FROM ${BUNDLE_PREFIX}/deepracer-simapp-build-bundle:${BUNDLE_TAG} AS bundle
FROM ${CORE_IMG}

ARG NVCC_VER=""
ARG TF_VER=""

ENV TZ="America/New_York" 
ENV DEBIAN_FRONTEND="noninteractive" 
RUN apt update && \ 
    apt upgrade -y && \
    apt install --no-install-recommends -y \
    apt-utils \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    dirmngr \
    ffmpeg \
    git \
    gnupg2 \
    jq \
    jwm \
    libavcodec-dev \
    libavformat-dev \
    libboost-all-dev \
    libfreetype-dev \
    libgomp1 \
    libhdf5-dev \
    libjpeg-dev \
    liblog4cplus-dev \
    libpng-dev \
    libssl-dev \
    libswscale-dev \
    libx264-dev \
    libxrender1 \
    libzmq3-dev \
    lsb-release \
    mesa-utils \
    net-tools \
    pkg-config \
    python3-dev \
    python3-opengl \
    python3-pip \
    python3-venv \
    tzdata \
    uuid-dev \
    wget \
    x11-xserver-utils \
    x11vnc \
    x264 \
    xmlstarlet \
    xvfb \
    zlib1g-dev \
    ${NVCC_VER} && \    
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# Set non-interactive frontend for apt
RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections

# Python won’t try to write .pyc or .pyo files on the import of source modules
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# See http://bugs.python.org/issue19846
ENV PYTHONIOENCODING=UTF-8
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=lyrical
ENV ROS_SNAPSHOT_DATE=2026-10-05

# nvidia-container-runtime
ENV NVIDIA_VISIBLE_DEVICES="all"
ENV NVIDIA_DRIVER_CAPABILITIES="all"
ENV MESA_DEBUG=silent

COPY docker/files/10_nvidia.json /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# Install ROS Lyrical (Gazebo Jetty is provided by the ROS vendor packages)

# Add ROS 2 repository key
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    gpg --keyserver keyserver.ubuntu.com --recv-keys 4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA && \
    gpg --export 4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA >> /usr/share/keyrings/ros-archive-keyring.gpg

# Add ROS 2 repository (using snapshots for reproducibility)
RUN sh -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://snapshots.ros.org/$ROS_DISTRO/$ROS_SNAPSHOT_DATE/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" > /etc/apt/sources.list.d/ros2.list'

RUN apt update -y && \
    apt install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-colcon-mixin \
        python3-defusedxml \
        python3-jsonschema \
        python3-rosdep \
        python3-shapely \
        python3-vcstool \
        python3-boto3 \
        ros-${ROS_DISTRO}-controller-manager \
        ros-${ROS_DISTRO}-gz-ros2-control \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-ros-core \
        ros-${ROS_DISTRO}-ros-gz \
        ros-${ROS_DISTRO}-ros2-controllers \
        ros-${ROS_DISTRO}-web-video-server \
        ros-${ROS_DISTRO}-xacro && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# Install docker (apt-key is not available on Ubuntu 26.04)
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list
RUN apt update && apt install --no-install-recommends -y docker-ce-cli && apt clean && rm -rf /var/lib/apt/lists/*
RUN curl -L "https://github.com/docker/compose/releases/download/v2.40.2/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose

# Create Python virtual environment and install SageMaker SDK
RUN python3 -m venv /root/sagemaker-venv && \
    /root/sagemaker-venv/bin/pip install --no-cache-dir --upgrade pip && \
    /root/sagemaker-venv/bin/pip install --no-cache-dir "sagemaker<3"

RUN python3 -m pip install --no-cache-dir --break-system-packages sagemaker-training 

# Copy installed libraries (Redis + AWS CPP + AWS CLI + Conda)
COPY --from=bundle /usr/local/ /usr/local/
COPY --from=bundle /root/anaconda/ /root/anaconda/

# Use the system libxml2: cv_bridge pulls in the system libspatialite, which needs xmlNanoHTTPCleanup,
# absent from conda-forge's libxml2. No-op if already removed in the core image.
RUN /root/anaconda/bin/conda list -n sagemaker_env --json '^libxml2-16$' | grep -q libxml2-16 && \
    /root/anaconda/bin/conda remove -n sagemaker_env --force -y libxml2-16 && \
    /root/anaconda/bin/conda clean -afy || true

# Copy compiled bundle
COPY --from=bundle /opt/amazon/install /opt/amazon/install
# Copy configurations and scripts
COPY --from=bundle /opt/amazon/configs /opt/amazon/configs
# Copy deepracer_node_monitor script and config files
COPY --from=bundle /opt/amazon/script /opt/amazon/script
COPY --from=bundle /opt/amazon/src/deepracer_node_monitor/config/*.txt /opt/amazon/script/config/

WORKDIR /opt/ml/code

# Install ROS dependencies
RUN apt update -y && rosdep init && rosdep update --rosdistro=${ROS_DISTRO} -q && \
    cd /opt/amazon/install && \
    rosdep install --rosdistro=${ROS_DISTRO} --from-paths . --ignore-src -r -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* && ldconfig

# Copy Sagemaker and misc files
COPY ./docker/files/ml-code /opt/ml/code
ENV SAGEMAKER_PROGRAM="sagemaker_bootstrap.py"

# Copy Robomaker scripts and configuration files
COPY ./docker/files/robomaker/run.sh /opt/ml/code/run.sh
COPY ./docker/files/robomaker/debug-reward.diff debug-reward.diff
COPY ./docker/files/robomaker/shutdown.sh /opt/ml/code/shutdown.sh

# Copy RL-Coach configuration files (local sagemaker training)
RUN mkdir -p /root/.sagemaker
COPY ./docker/files/rl-coach/config.yaml /root/.sagemaker/config.yaml
COPY ./docker/files/rl-coach/start.py /opt/ml/code/rl_coach/start.py

# Fix REDIS
RUN mkdir -p /etc/redis && cp /opt/ml/code/redis.conf /etc/redis/redis.conf

# Add labels
COPY VERSION .
ARG IMG_VERSION
LABEL maintainer="AWS DeepRacer Community - deepracing.io"
LABEL version="${IMG_VERSION}"

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["bash"]