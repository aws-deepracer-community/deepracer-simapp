# Optimized Dockerfile for public.ecr.aws/aws-solutions/deepracer-on-aws-simapp:v1.4.0
# Image ID: f832a38a24b4
# Base: Ubuntu 26.04 (Resolute)
# Built: November 10, 2026
# Optimized: November 11, 2026

FROM ubuntu:26.04

# Set ROS distribution
ENV ROS_DISTRO=lyrical
ENV ROS_SNAPSHOT_DATE=2026-10-05

# Set debconf frontend for apt
RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections

# Install base system packages, Python 3.14, development dependencies, Xvfb and window manager
RUN apt-get update && apt-get -y upgrade && apt-get install -y \
    git \
    curl \
    lsb-release \
    wget \
    build-essential \
    nano \
    libopenblas-dev \
    gfortran \
    libgeos-dev \
    locales \
    software-properties-common \
    sudo \
    gpg \
    dirmngr \
    unzip \
    python3-pip \
    python3-apt \
    python3.14 \
    python3.14-dev \
    python3.14-venv \
    python3-venv \
    libreadline-dev \
    libncurses-dev \
    libssl-dev \
    libsqlite3-dev \
    tk-dev \
    libgdbm-dev \
    libc6-dev \
    libbz2-dev \
    libffi-dev \
    zlib1g-dev \
    libcurl4-openssl-dev \
    libjitterentropy3-dev \
    libzstd-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    liblog4cplus-dev \
    libgmock-dev \
    xvfb \
    jwm \
    x11-apps \
    libarchive-tools \
    && rm -rf /var/lib/apt/lists/*

# Use bsdtar as tar during the build (removed again at the end)
RUN ln -s /usr/bin/bsdtar /usr/local/bin/tar

# Install AWS CLI v2
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Remove EXTERNALLY-MANAGED file to allow pip installs system-wide
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# Add ROS 2 repository keys
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    gpg --keyserver keyserver.ubuntu.com --recv-keys 4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA && \
    gpg --export 4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA >> /usr/share/keyrings/ros-archive-keyring.gpg

# Add ROS 2 repository
RUN sh -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://snapshots.ros.org/$ROS_DISTRO/$ROS_SNAPSHOT_DATE/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" > /etc/apt/sources.list.d/ros2.list'

# Install ROS 2 Lyrical packages and record installed ROS package versions
RUN apt-get update && apt-get install -y --no-install-recommends \
    # ROS 2 Lyrical packages
    ros-$ROS_DISTRO-ros-base \
    ros-$ROS_DISTRO-ackermann-msgs \
    ros-$ROS_DISTRO-ament-cmake \
    ros-$ROS_DISTRO-ament-package \
    ros-$ROS_DISTRO-controller-manager \
    ros-$ROS_DISTRO-ros2-controllers \
    ros-$ROS_DISTRO-ros-gz \
    ros-$ROS_DISTRO-gz-ros2-control \
    ros-$ROS_DISTRO-robot-state-publisher \
    ros-$ROS_DISTRO-sensor-msgs \
    ros-$ROS_DISTRO-std-msgs \
    ros-$ROS_DISTRO-xacro \
    # ros-$ROS_DISTRO-desktop \
    ros-$ROS_DISTRO-image-transport \
    ros-$ROS_DISTRO-web-video-server \
    ros-$ROS_DISTRO-rosidl-typesupport-c \
    # Python packages for ROS
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-psutil \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/amazon \
    && dpkg-query -W -f '${Package} ${Version}\n' 'ros-*' > /opt/amazon/ros-packages.txt

# Create required directories
RUN mkdir -p /root/.gazebo/models \
    /root/.gazebo/worlds

# Configure ROS and Gazebo environment in bashrc
RUN echo "source /opt/ros/$ROS_DISTRO/setup.bash" >> ~/.bashrc && \
    echo "export GZ_VERSION=jetty" >> ~/.bashrc && \
    echo "export GZ_SIM_RESOURCE_PATH=/opt/ros/$ROS_DISTRO/opt/gz_sim_vendor/share/gz/gz-sim" >> ~/.bashrc && \
    echo "export GZ_SIM_SYSTEM_PLUGIN_PATH=/opt/ros/$ROS_DISTRO/opt/gz_sim_vendor/lib/gz-sim-10/plugins" >> ~/.bashrc

# Build and install AWS SDK C++ (pinned to a verified commit)
ARG AWS_SDK_CPP_TAG=1.11.907
ARG AWS_SDK_CPP_COMMIT=a9f0ffcc276664b475230206fa554841ad5bc3de
RUN git clone --depth 1 --branch "$AWS_SDK_CPP_TAG" --recurse-submodules --shallow-submodules https://github.com/aws/aws-sdk-cpp.git && \
    test "$(git -C aws-sdk-cpp rev-parse HEAD)" = "$AWS_SDK_CPP_COMMIT" && \
    cd aws-sdk-cpp && mkdir build && cd build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DCPP_STANDARD=17 \
      -DCMAKE_PREFIX_PATH=/usr/local \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DBUILD_SHARED_LIBS=ON \
      -DENABLE_TESTING=OFF \
      -DAUTORUN_UNIT_TESTS=OFF \
      -DBUILD_ONLY="core;logs;kinesis" \
      -DMINIMIZE_SIZE=ON && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd ../.. && rm -rf aws-sdk-cpp

# Build and install Redis 8.10.2
RUN cd /tmp && \
    wget -q https://download.redis.io/releases/redis-8.10.2.tar.gz && \
    echo "b9ffee226b5eecdba98a679260dad764b2a4ebd90dce4ad5ac9e9f3eef9c02b3  redis-8.10.2.tar.gz" | sha256sum -c - && \
    tar xzf redis-8.10.2.tar.gz && \
    cd redis-8.10.2 && \
    rm -rf modules/redisbloom modules/redisearch modules/redisjson modules/redistimeseries && \
    make -j"$(nproc)" && \
    make install && \
    cd /tmp && \
    rm -rf redis-8.10.2 redis-8.10.2.tar.gz

# Install Python dependencies
RUN python3 -m pip install --no-cache-dir --ignore-installed \
    zipp==4.1.1 \
    pygame-ce==2.5.8 \
    shapely==2.2.0 \
    pyparsing==3.3.3 \
    python-dateutil==2.9.0.post0 \
    pillow==13.0.0 \
    pyyaml==6.0.3 \
    requests==2.34.2 \
    urllib3==2.8.0 \
    empy==4.2.1 \
    boto3==1.43.109 \
    bokeh==3.10.0 \
    cryptography==50.0.2 \
    docutils==0.23 \
    h5py==3.15.1 \
    jsonschema==4.26.0 \
    kubernetes==37.0.0 \
    matplotlib==3.11.2 \
    minio==7.2.20 \
    numpy==2.5.3 \
    off-your-rocker==0.1.0 \
    rospkg==1.6.3 \
    scipy==1.18.1 \
    scikit-image==0.26.0 \
    tokenize-rt==6.2.0 \
    pandas==3.0.6 \
    PyOpenGL==3.1.10 \
    pytest==9.1.1 \
    pytest-cov==7.1.0 \
    pytest-rerunfailures==16.7 \
    pytz==2026.5 \
    tensorflow==2.22.0rc0 \
    keras-nightly==3.16.0.dev2026100704 \
    tensorflow-probability==0.25.0 \
    protobuf==7.36.2 \
    lark==1.3.1 \
    catkin_pkg==1.1.1 \
    typeguard==4.6.0 \
    setuptools==84.0.0 \
    wheel==0.48.0

# Install tf_keras (no deps, it pins tensorflow<2.22) and annoy
RUN python3 -m pip install --no-cache-dir --no-deps tf_keras==2.21.0 && \
    python3 -m pip install --no-cache-dir --use-pep517 annoy==1.17.3

ENV CONDA_DIR=/root/anaconda/

# Miniconda setup
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-py314_26.7.1-1-Linux-x86_64.sh -O ~/miniconda.sh && \
    echo "e8b25b92b262499141c5bd57a98d3c008024185fa951494b9cd9b6d94e72338b  $HOME/miniconda.sh" | sha256sum -c - && \
    /bin/bash ~/miniconda.sh -b -p /root/anaconda/ && \
    rm ~/miniconda.sh && \
    /root/anaconda/bin/conda config --system --remove-key channels 2>/dev/null; \
    /root/anaconda/bin/conda config --system --add channels conda-forge && \
    /root/anaconda/bin/conda config --system --set channel_priority strict

# Create conda environment
COPY ./bundle/configs /opt/amazon/configs
RUN /root/anaconda/bin/conda env create -f /opt/amazon/configs/environment.yml && \
    /root/anaconda/bin/conda clean -afy

# Pin conda itself and install security updates via conda
RUN /root/anaconda/bin/conda list --export '^(conda|py-rattler)$' | grep -v '^#' > /root/anaconda/conda-meta/pinned && \
    test "$(wc -l < /root/anaconda/conda-meta/pinned)" -eq 2 && \
    /root/anaconda/bin/conda install -y \
    conda-forge::curl==8.23.0 \
    conda-forge::libcurl==8.23.0 \
    urllib3==2.8.0 \
    pyjwt==2.15.0 \
    certifi==2026.10.19 \
    anyio==4.14.2 \
    filelock==4.2.1 \
    msgpack-python==1.2.3 && \
    /root/anaconda/bin/conda clean -afy

# Install RL Coach into the conda environment
COPY ./bundle/rl_coach /opt/amazon/rl_coach
RUN /root/anaconda/envs/sagemaker_env/bin/pip install --no-cache-dir -e /opt/amazon/rl_coach && \
    /root/anaconda/envs/sagemaker_env/bin/pip install --no-cache-dir --no-deps tf_keras==2.21.0

# Configure sagemaker_env environment PYTHONPATH
RUN mkdir -p /root/anaconda/envs/sagemaker_env/etc/conda/activate.d && \
    echo 'export PYTHONPATH=/opt/ros/lyrical/lib/python3.14/site-packages:/opt/ros/lyrical/local/lib/python3.14/dist-packages:$PYTHONPATH' > /root/anaconda/envs/sagemaker_env/etc/conda/activate.d/env_vars.sh

# Create required directories
RUN mkdir -p /opt/ml/code

# Copy DeepRacer source code and assets
COPY ./bundle/markov /opt/amazon/markov
COPY ./bundle/src /opt/amazon/src
COPY ./bundle/sagemaker-containers /opt/amazon/sagemaker-containers
COPY ./bundle/meshes /opt/amazon/meshes
COPY ./bundle/models /opt/amazon/models
COPY ./bundle/urdf /opt/amazon/urdf
COPY ./bundle/routes /opt/amazon/routes
COPY ./bundle/worlds /opt/amazon/worlds
COPY ./bundle/track_iconography /opt/amazon/track_iconography
COPY ./bundle/colcon_bundle.patch /opt/amazon/colcon_bundle.patch
COPY ./bundle/script /opt/amazon/script
COPY ./bundle/src/deepracer_node_monitor/config/*.txt /opt/amazon/script/config/
COPY ./docker/files/ml-code /opt/ml/code
COPY ./docker/files/ml-code/redis.conf /etc/redis/redis.conf

# Install RL Coach into the system Python
RUN pip3 install /opt/amazon/rl_coach --no-deps

# Initialize rosdep and add custom rosdep sources
RUN rosdep init && \
    sh -c 'echo "yaml https://deepracer-managed-resources-us-east-1.s3.amazonaws.com/rosdep/python.yaml" > /etc/ros/rosdep/sources.list.d/18-deepracer.list' && \
    rosdep update

# Build DeepRacer ROS packages
RUN /opt/ml/code/scripts/build_deepracer_ros_packages.sh && \
    rm -rf /opt/amazon/log /opt/amazon/build

# Copy and execute custom SageMaker containers setup
COPY docker/files/ml-code/custom-sagemaker-containers.sh /tmp/custom-sagemaker-containers.sh
RUN /tmp/custom-sagemaker-containers.sh

# Set environment variables for SageMaker and Python
ENV SAGEMAKER_TRAINING_MODULE=sagemaker_bootstrap:sageonly
ENTRYPOINT ["/bin/bash", "-c"]
ENV PYTHONPATH=/opt/ml/code/:
WORKDIR /opt/ml/code/
ENV PYTHONUNBUFFERED=1
ENV FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH=/root/anaconda//bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Initialize conda for bash
RUN /bin/bash -c "conda init bash"

# Remove anaconda-anon-usage and vendored/bundled files flagged by security scanners
RUN /root/anaconda/bin/conda remove -y --override-channels -c conda-forge anaconda-anon-usage 2>/dev/null || \
        /root/anaconda/bin/pip uninstall -y anaconda-anon-usage || true; \
    rm -rf /root/anaconda/pkgs/anaconda-anon-usage-* && \
    ! ls -d /root/anaconda/lib/python3.14/site-packages/anaconda_anon_usage* 2>/dev/null && \
    rm -rf /root/anaconda/envs/sagemaker_env/lib/python3.14/site-packages/tensorflow/include/external/curl && \
    rm -rf /usr/local/lib/python3.14/dist-packages/tensorflow/include/external/curl && \
    rm -rf /usr/local/aws-cli/v2/*/dist/wheel* && \
    rm -rf /usr/local/lib/python3.14/dist-packages/setuptools/_vendor/wheel* && \
    rm -rf /root/anaconda/lib/python3.14/site-packages/setuptools/_vendor/wheel* && \
    rm -rf /root/anaconda/envs/sagemaker_env/include/openssl/opensslv.h && \
    rm -rf /root/anaconda/include/openssl/opensslv.h && \
    rm -f /usr/bin/pebble

# Restore interactive debconf frontend
RUN echo 'debconf debconf/frontend select Dialog' | debconf-set-selections

# Remove the bsdtar override
RUN rm /usr/local/bin/tar

# Note: This is an optimized version of the reverse-engineered Dockerfile.
# Optimizations include:
# - Consolidated apt-get commands
# - Improved build cache efficiency
